<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Base surface colors  -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF323232" />
    <SolidColorBrush x:Key="TabHeaderForeground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TabBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="TabContentBackground" Color="#FF353535" />
    <SolidColorBrush x:Key="TabBackgroundHover" Color="#FF404040" />
    <!--  Must match TabContentBackground exactly: the selected tab visually
          merges into the content card below it.  -->
    <SolidColorBrush x:Key="TabBackgroundChecked" Color="#FF353535" />
    <!--  ~50% lighter than TabBackground (assumption - flag if this isn't
          what was meant).  -->
    <SolidColorBrush x:Key="TabBackgroundDisabled" Color="#FF454545" />

    <!--  Text colors  -->
    <SolidColorBrush x:Key="TabForeground" Color="#B4B4B4" />
    <SolidColorBrush x:Key="TabForegroundHover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TabForegroundChecked" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabForegroundDisabled" Color="#6E6E6E" />

    <SolidColorBrush x:Key="TabBorderHover" Color="#FF606060" />

    <!--  Accent  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4DB2FF" />
    <SolidColorBrush x:Key="AccentBrushMuted" Color="#2E5C80" />

    <SolidColorBrush x:Key="GroupBackground" Color="#2A2A2A" />
    <SolidColorBrush x:Key="HeaderStripBackground" Color="#2A2A2A" />

    <!--  Typography  -->
    <FontFamily x:Key="TabFontFamily">Segoe UI</FontFamily>

    <!--  Shape tokens  -->
    <CornerRadius x:Key="TabCornerRadius">6,6,5,5</CornerRadius>
    <CornerRadius x:Key="ContentCornerRadius">0,6,6,6</CornerRadius>
    <Thickness x:Key="TabPadding">14,0,14,0</Thickness>

    <!--  Content card shadow  -->
    <DropShadowEffect
        x:Key="ContentCardShadow"
        BlurRadius="14"
        Direction="270"
        Opacity="0.28"
        ShadowDepth="2"
        Color="#000000" />

</ResourceDictionary>
