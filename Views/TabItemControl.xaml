<UserControl
    x:Class="TabLayout.Views.TabItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TabLayout.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ClipToBounds="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TabLayout;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5,0,0,0">
        <Border
            BorderThickness="1,1,1,0"
            CornerRadius="5,5,0,0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="LightGray" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultMenuBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Margin" Value="0,3,0,0" />
                    <Setter Property="Padding" Value="5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="DodgerBlue" />
                            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Margin" Value="0,1,0,-0.5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                Text="{Binding Header}" />
        </Border>
        <Rectangle
            Height="1"
            Margin="0,29,0,0"
            VerticalAlignment="Bottom"
            Panel.ZIndex="101">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Panel.ZIndex" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource CardBackgroundFillColorDefaultMenuBrush}" />
                            <Setter Property="Panel.ZIndex" Value="101" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
    </Grid>

</UserControl>
