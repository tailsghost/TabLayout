<UserControl
    x:Class="TabLayout.Views.TabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TabLayout.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource TabContentBackground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TabLayout;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <!--  Backdrop behind the tab row, with a full-width accent line
              across the bottom (like the native VS document tab strip).
              The selected tab's own border sits directly on top of this
              line, so they merge automatically - same color, no need to
              hide/patch anything, even if pixel alignment isn't perfect.  -->
        <Border
            Height="32"
            VerticalAlignment="Top"
            Background="{DynamicResource HeaderStripBackground}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,2" />

        <!--  Content card. Always outlined in the accent color; no top border,
              because the selected tab's own border (no bottom side) sits
              directly above it and visually continues the same outline.
              No other tab draws a line, so there is nothing to hide/patch.  -->
        <Border
            Margin="0,32,0,0"
            Padding="14"
            Background="{DynamicResource TabContentBackground}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1,0,1,1"
            Effect="{DynamicResource ContentCardShadow}">
            <ContentControl Content="{Binding SelectedItem.Content}" />
        </Border>

        <ItemsControl
            VerticalAlignment="Top"
            Background="Transparent"
            ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TabItemControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>
